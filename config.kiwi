<?xml version="1.0" encoding="utf-8"?>
<image schemaversion="7.4" name="ConorNitroOS">
    <description type="system">
        <author>Conor Gamer</author>
        <specification>Sistema Operativo Híbrido Gamer - Conor Nitro</specification>
    </description>
    <preferences>
        <type image="iso" hybrid="true"/>
        <version>1.1.0</version>
        <packagemanager>zypper</packagemanager>
    </preferences>
    <packages type="image">
        <package name="patterns-microos-base"/>
        <package name="kernel-default"/>
        <package name="xfce4-session"/>
        <package name="xfce4-panel"/>
        <package name="xfce4-terminal"/>
        <package name="arc-theme"/>
        <package name="papirus-icon-theme"/>
        <package name="bibata-cursor-themes"/>
        <package name="NetworkManager"/>
        <package name="bluez"/>
        <package name="steam"/>
    </packages>
    <files>
        <file name="conor_nitro_daemon.py" target="/"/>
        <file name="conor_nitro_tools.py" target="/"/>
        <file name="mouse_firmware.py" target="/"/>
        <file name="conor_wallpaper.png" target="/"/>
        <file name="conor-gamer-os" target="/usr/share/plymouth/themes/"/>
        <file name="conor_menu_icon.svg" target="/usr/share/icons/hicolor/scalable/apps/"/>
    </files>
    <scripts>
        <postinclude file="setup_conor.sh"/>
    </scripts>
</image>
